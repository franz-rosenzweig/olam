# Olam's settings. Copy this to olam.env in the data folder (data/ by default), or set them in the environment.
# Every line is optional.

# Where Olam keeps its index, downloads and password. Default: data/ next to the code.
# (This one has to be set in the environment, since olam.env lives in it.)
# OLAM_DATA=/var/lib/olam

# Addresses to listen on, comma-separated, and the port.
# OLAM_HOSTS=127.0.0.1
# OLAM_PORT=8462

# Olam's own address, for the links it writes into vault notes.
# OLAM_URL=http://localhost:8462

# Your Obsidian vault: lesson notes, the bestiary, encounters, and the Map, People and Table screens.
# OLAM_VAULT=/home/you/Obsidian/Olam

# A Calibre library (the folder with metadata.db). Its EPUBs are indexed for search and stay on this machine.
# OLAM_CALIBRE=/home/you/Calibre Library

# kiwix-serve, for opening the archives in full.
# OLAM_KIWIX_URL=http://localhost:8461

# The AI features use the Claude API with a key, or else the Claude CLI signed in to a Claude subscription.
# ANTHROPIC_API_KEY=sk-ant-...
# OLAM_CLAUDE=/home/you/.local/bin/claude
# OLAM_MODEL=claude-sonnet-5-5
# OLAM_AI=0     # turn them off

# The public demo: no sign-in, open-licensed sources only, no AI, books or vault, progress kept in each browser.
# Build its own library with OLAM_DEMO=1 OLAM_DB=data/demo.db olam ingest open5e srd
# OLAM_DEMO=1
# OLAM_DB=data/demo.db
