<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark, as Olam is. The window is edge to edge (MainActivity pads it), so the bars
         are see-through and the ground shows behind them. -->
    <style name="Theme.Olam.Base" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:colorAccent">@color/brass</item>
        <item name="android:colorControlActivated">@color/brass</item>
        <item name="android:colorControlNormal">@color/line2</item>
        <item name="android:textColorHighlight">@color/brassLine</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.Olam" parent="Theme.Olam.Base" />

    <style name="Olam.Button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/alegreya_sans</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Olam.Button.Primary">
        <item name="android:fontFamily">@font/alegreya_sans_bold</item>
        <item name="android:textColor">@color/onBrass</item>
        <item name="android:background">@drawable/btn_primary</item>
    </style>
    <style name="Olam.Eyebrow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/alegreya_sans</item>
        <item name="android:textColor">@color/dim</item>
    </style>
</resources>
